    "cypher": "MATCH (publisher:方法)-[publish:发布至]->(exchange:消息交换机)-[route:路由至]->(queue:消息队列 {队列名称: 'food_delivery'})-[:消费自]->(consumer:方法), (publisher)-[:归属于]->(:类)-[:归属于]->(sender:微服务), (consumer)-[:归属于]->(:类)-[:归属于]->(receiver:微服务) WHERE publish.路由键 = route.路由键 RETURN DISTINCT publisher.全限定名 AS 发布方法, sender.服务名称 AS 发送服务, exchange.交换机名称 AS 交换机名称, queue.队列名称 AS 队列名称, consumer.全限定名 AS 消费方法, receiver.服务名称 AS 接收服务",

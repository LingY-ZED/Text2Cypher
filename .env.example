# Copy this file to .env and replace every placeholder locally.
# Never commit real credentials or API keys.
TEXT2CYPHER_NEO4J_URI=bolt://localhost:7687
TEXT2CYPHER_NEO4J_USERNAME=neo4j
TEXT2CYPHER_NEO4J_PASSWORD=replace-me
TEXT2CYPHER_NEO4J_DATABASE=neo4j

# OpenAI-compatible Chat Completions endpoint base URL.
TEXT2CYPHER_LLM_BASE_URL=https://api.openai.com/v1
TEXT2CYPHER_LLM_API_KEY=replace-me
TEXT2CYPHER_LLM_MODEL=replace-me
TEXT2CYPHER_LLM_TIMEOUT_SECONDS=30

TEXT2CYPHER_SCHEMA_TIMEOUT_SECONDS=10
TEXT2CYPHER_QUERY_TIMEOUT_SECONDS=10
TEXT2CYPHER_MAX_RESULT_ROWS=100
TEXT2CYPHER_LOG_LEVEL=INFO


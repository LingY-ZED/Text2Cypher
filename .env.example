# 将本文件复制为 .env，并在本地替换所有占位值。
# 真实凭据和 API Key 禁止提交到版本库。
TEXT2CYPHER_NEO4J_URI=bolt://localhost:7687
TEXT2CYPHER_NEO4J_USERNAME=neo4j
TEXT2CYPHER_NEO4J_PASSWORD=replace-me
TEXT2CYPHER_NEO4J_DATABASE=neo4j

## OpenAI 兼容聊天补全服务的基础地址。
TEXT2CYPHER_LLM_BASE_URL=https://api.deepseek.com
TEXT2CYPHER_LLM_API_KEY=replace-me
TEXT2CYPHER_LLM_MODEL=deepseek-v4-flash
TEXT2CYPHER_LLM_TIMEOUT_SECONDS=60
TEXT2CYPHER_LLM_MAX_TOKENS=1024
# 仅对支持该扩展字段的模型服务启用；默认 false 以使用模型自身的思考策略。
TEXT2CYPHER_LLM_DISABLE_THINKING=false

# 对 LLM 和 Neo4j 的瞬态故障最多尝试三次；关闭后每次操作只请求一次。
TEXT2CYPHER_RETRY_ENABLED=true
TEXT2CYPHER_RETRY_MAX_ATTEMPTS=3
TEXT2CYPHER_RETRY_BASE_DELAY_SECONDS=0.5
TEXT2CYPHER_RETRY_MAX_DELAY_SECONDS=4.0

# 主 Cypher 生成失败时只纠错一次；空结果复核可单独关闭。
TEXT2CYPHER_CYPHER_CORRECTION_ENABLED=true
TEXT2CYPHER_EMPTY_RESULT_CORRECTION_ENABLED=true

TEXT2CYPHER_QUESTION_DECOMPOSITION_ENABLED=true
TEXT2CYPHER_QUESTION_DECOMPOSITION_MAX_SUBQUESTIONS=3

TEXT2CYPHER_FEW_SHOT_ENABLED=true
TEXT2CYPHER_FEW_SHOT_TOP_K=3
TEXT2CYPHER_FEW_SHOT_MAX_CHARS=3500
TEXT2CYPHER_FEW_SHOT_LIBRARY_PATH=

# 查询成功后使用共享 LLM 生成自然语言答案；输入超限、零结果或模型失败时自动模板降级。
TEXT2CYPHER_NATURAL_LANGUAGE_SUMMARY_ENABLED=true
TEXT2CYPHER_NATURAL_LANGUAGE_SUMMARY_MAX_INPUT_CHARS=16000

TEXT2CYPHER_SCHEMA_TIMEOUT_SECONDS=10
TEXT2CYPHER_QUERY_TIMEOUT_SECONDS=10
TEXT2CYPHER_MAX_RESULT_ROWS=100
TEXT2CYPHER_LOG_LEVEL=INFO
